# Template pour les variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs

# Mot de passe pour les bases de données PostgreSQL
DB_PASSWORD=your_secure_password_here

# Utilisateur pour les bases de données (optionnel, défaut: demo)
DB_USER=demo

# Mot de passe pour l'utilisateur Debezium (si différent)
DEBEZIUM_DB_PASSWORD=your_debezium_password_here
