# Configuration pour le déploiement local
# Copier ce fichier en .env et remplir les valeurs avant de lancer docker-compose

# =========================================================
# Bases de données (AbAssurance et AssurePlus)
# =========================================================
POSTGRES_PASSWORD=your_secure_password_here

# =========================================================
# Producer - Accès aux bases
# =========================================================
DB_USER=demo
DB_PASSWORD=your_secure_password_here
AB_DB_HOST=db-abassur
AB_DB_NAME=abassurance
AP_DB_HOST=db-assureplus
AP_DB_NAME=assureplus

# =========================================================
# Kafka
# =========================================================
KAFKA_BOOTSTRAP=kafka:9092
